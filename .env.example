# Salin file ini menjadi .env dan sesuaikan nilainya

# Database PostgreSQL
DATABASE_URL=postgresql+psycopg://nalar:nalar@localhost:5432/nalar_ai

# Keamanan JWT — ganti dengan string random yang panjang dan kuat di production
SECRET_KEY=changeme-generate-a-random-secret-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — daftar origin frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000
