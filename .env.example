# Salin file ini menjadi ".env" dan sesuaikan nilainya.

# Koneksi PostgreSQL (driver psycopg v3, dipakai sync oleh Alembic & async oleh app)
DATABASE_URL=postgresql+psycopg://nalar:nalar@localhost:5432/nalar_ai

# Kunci rahasia untuk menandatangani JWT. WAJIB diganti saat deployment.
SECRET_KEY=ganti-dengan-random-secret-yang-panjang

# Algoritma JWT & lama berlaku token akses (menit)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Daftar origin frontend yang diizinkan mengakses API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000
